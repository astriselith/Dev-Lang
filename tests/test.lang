class Ponto();

class Vec2(x: Float, y: Float) : Ponto() {
    var x : Float;
    var y : Float;

    operator a: Self + b: Self : Self {
        return Vec2(a.x + b.x, a.y + b.y);
    };

    operator a: Self * b: Float : Self {
        return Vec2(a.x * b, a.y * b);
    };
};

