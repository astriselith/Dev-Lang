    return third;
};

operator a: Any ? : Bool {
    println("global any question operator");
    return !isNull(a);
};

class A(b: Bool) : Stringfiable() {
    var should: Bool -> b;

    operator a: A ? : Bool {
        println("A question operator");
        if(isNull(a)) {
            return false;
        } else {
            return a.should;
        }
    };

    operator a: A = b: A : A {
        return a;
    };

    fun stringfy(): String {
        return "A";
    };
};

